# Production origin, no trailing slash. Used for canonical URLs, Open Graph and sitemap.xml.
SITE_URL=https://example.com

# Your own backend endpoint that receives the project brief as JSON (see README → "Brief endpoint").
# VITE_* values are bundled into the browser and are PUBLIC. Never put secrets here
# (Telegram bot tokens, API keys, SMTP passwords stay on the server).
VITE_BRIEF_ENDPOINT=

# true for production, false for staging (adds noindex and a Disallow-all robots.txt).
ROBOTS_ALLOW=true
